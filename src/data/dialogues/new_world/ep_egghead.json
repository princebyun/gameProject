{
  "episodeId": "ep_egghead",
  "islandId": "egghead",
  "seaZoneId": "new_world",
  "scripts": [
    {
      "scriptId": "nw5_egghead_arrival",
      "episodeId": "ep_egghead",
      "triggerType": "gold_marker",
      "title": "미래섬 에그헤드 — 베가펑크 연구소와 포위망",
      "bindingId": "npc_vegapunk",
      "lines": [
        {
          "speakerId": "narrator",
          "speakerName": "내레이션",
          "emotion": "normal",
          "side": "center_narration",
          "text": "인류보다 500년 앞선 과학의 섬 에그헤드. 그러나 천재 과학자 베가펑크에게 세계정부의 암살령이 떨어졌다.",
          "directives": [
            {
              "type": "chapterCard",
              "chapterNum": "제4장 · 신세계 최종장",
              "title": "미래섬 에그헤드 사건",
              "subtitle": "해군 대장 키자루와 오로성 새턴 성"
            },
            { "type": "bgm", "trackId": "island_peaceful", "fadeSec": 0.4 }
          ]
        },
        {
          "speakerId": "npc_vegapunk",
          "speakerName": "Dr. 베가펑크 (스텔라)",
          "emotion": "shocked",
          "side": "right",
          "text": "오오, 사황 밀짚모자!! 나를 이 섬에서 탈출시켜 주게! 공백의 100년 진실을 전 세계에 알려야 하네!"
        },
        {
          "speakerId": "franky",
          "speakerName": "사이보그 · 프랑키",
          "emotion": "excited",
          "side": "left",
          "text": "우오오! 베가펑크 박사님!! 이 슈퍼한 미래 연구소를 부수게 둘 순 없지! 프론티어 돔부터 열자!"
        },
        {
          "speakerId": "sanji",
          "speakerName": "검은 다리 · 상디",
          "emotion": "angry",
          "side": "left",
          "text": "젠장! CP0 로브 루치에 세라핌 S-호크, 게다가 해군 대장 키자루와 오로성까지 상륙했어!"
        },
        {
          "speakerId": "npc_vegapunk",
          "speakerName": "Dr. 베가펑크 (스텔라)",
          "emotion": "determined",
          "side": "right",
          "text": "오로성 새턴 성은 상처가 즉시 아물어 버리는 괴물이라네. 강한 패왕색 일격으로 재생을 끊어야 해!"
        },
        {
          "speakerId": "luffy",
          "speakerName": "몽키 D. 루피",
          "emotion": "determined",
          "side": "left",
          "text": "사과 아저씨는 우리가 지킨다! 프론티어 돔 스위치를 해제하고 포위망을 정면 돌파하자!"
        }
      ]
    },
    {
      "scriptId": "nw5_shawk_lucci_pre_boss",
      "episodeId": "ep_egghead",
      "triggerType": "pre_boss",
      "title": "세라핌 S-호크 & CP0 각성 루치 조우",
      "bindingId": "enc_egghead_shawk_lucci",
      "lines": [
        {
          "speakerId": "lucci",
          "speakerName": "CP0 · 각성 로브 루치",
          "emotion": "smirk",
          "side": "right",
          "text": "다시 만났군, 밀짚모자. 나는 너를 사황으로 인정하지 않는다. 각성 레오파드의 검은 구름을 봐라!",
          "directives": [
            { "type": "bgm", "trackId": "battle_boss", "fadeSec": 0.3 },
            { "type": "sfx", "sfxId": "transform_burst" }
          ]
        },
        {
          "speakerId": "s_hawk",
          "speakerName": "세라핌 · S-호크",
          "emotion": "normal",
          "side": "right",
          "text": "(명령 수신: 타깃 섬멸 개시. 루나리아족 방어 불꽃 점화 및 흑도 참격 전개.)"
        },
        {
          "speakerId": "zoro",
          "speakerName": "롤로노아 조로",
          "emotion": "determined",
          "side": "left",
          "text": "킹과 같은 루나리아족 불꽃에 매의 눈 검술이군. 불꽃이 꺼질 때를 노려 단숨에 베어버린다!"
        },
        {
          "speakerId": "luffy",
          "speakerName": "몽키 D. 루피",
          "emotion": "excited",
          "side": "left",
          "text": "루치! 2년 전보다 훨씬 강해졌구나! 그럼 나도 제대로 상대해주지!"
        }
      ]
    },
    {
      "scriptId": "nw5_saturn_pre_boss",
      "episodeId": "ep_egghead",
      "triggerType": "pre_boss",
      "title": "대장 키자루 & 오로성 새턴 성 포위 탈출전",
      "bindingId": "enc_egghead_kizaru_saturn",
      "lines": [
        {
          "speakerId": "kizaru",
          "speakerName": "해군 대장 · 보르살리노 (키자루)",
          "emotion": "normal",
          "side": "right",
          "text": "무섭네요~ 사황 밀짚모자. 속도는 곧 무게... 빛의 속도로 차인 적이 있나요?",
          "directives": [
            { "type": "bgm", "trackId": "battle_yonko_awakening", "fadeSec": 0.35 },
            { "type": "sfx", "sfxId": "beam_fire" },
            { "type": "screenFlash", "color": "#fef08a", "durationSec": 0.25 }
          ]
        },
        {
          "speakerId": "saturn",
          "speakerName": "오로성 · 제이가르시아 새턴 성",
          "emotion": "angry",
          "side": "right",
          "text": "하등한 벌레 주제에 태양의 신의 힘을 깨우다니... 우규(규키)의 초재생 앞에서 절망해라!",
          "directives": [{ "type": "cameraShake", "intensity": 0.9, "durationSec": 0.45 }]
        },
        {
          "speakerId": "luffy",
          "speakerName": "몽키 D. 루피",
          "emotion": "determined",
          "side": "left",
          "text": "아무리 재생해도 소용없어! 패왕색을 꽉 담은 일격으로 재생을 멈추고 둘 다 날려버리겠어!"
        },
        {
          "speakerId": "sanji",
          "speakerName": "검은 다리 · 상디",
          "emotion": "determined",
          "side": "left",
          "text": "해안 쪽에 거대한 배가 다가오고 있어! 루피, 저 괴물 둘만 묶어두면 탈출할 수 있다!"
        },
        {
          "speakerId": "saturn",
          "speakerName": "오로성 · 제이가르시아 새턴 성",
          "emotion": "angry",
          "side": "right",
          "text": "이 섬에서 단 한 명도 살려 보내지 않겠다!! 오로성의 위엄을 새겨주마!"
        }
      ]
    },
    {
      "scriptId": "nw5_egghead_post_boss",
      "episodeId": "ep_egghead",
      "triggerType": "post_boss",
      "title": "거병 해적단 엄호 속 에그헤드 출항",
      "bindingId": "enc_egghead_kizaru_saturn",
      "lines": [
        {
          "speakerId": "luffy",
          "speakerName": "기어 5 · 몽키 D. 루피",
          "emotion": "excited",
          "side": "left",
          "text": "고무고무 화이트 스타 건!! 둘 다 바다 저편으로 날아가 버려라!!",
          "directives": [
            { "type": "cameraShake", "intensity": 1.0, "durationSec": 0.5 },
            { "type": "screenFlash", "color": "#ffffff", "durationSec": 0.3 },
            { "type": "sfx", "sfxId": "awakening_drums" }
          ]
        },
        {
          "speakerId": "npc_dorry",
          "speakerName": "청귀 도리",
          "emotion": "excited",
          "side": "right",
          "text": "게갸갸갸!! 오래 기다렸다, 태양의 신 밀짚모자!! 거병 해적단이 마중 나왔다!!",
          "directives": [{ "type": "bgm", "trackId": "sea_new_world", "fadeSec": 0.45 }]
        },
        {
          "speakerId": "npc_brogy",
          "speakerName": "적귀 브로기",
          "emotion": "excited",
          "side": "right",
          "text": "가바바바!! 해군 버스터 콜 함대는 우리에게 맡겨라! 어서 거인족의 나라 엘바프로 가자!!"
        },
        {
          "speakerId": "usopp",
          "speakerName": "저격수 · 우솝",
          "emotion": "excited",
          "side": "left",
          "text": "도리 아저씨!! 브로기 아저씨!! 꿈에 그리던 전사의 나라 엘바프에 드디어 가는 거야!!"
        },
        {
          "speakerId": "jinbe",
          "speakerName": "해협의 · 징베",
          "emotion": "determined",
          "side": "left",
          "text": "키를 단단히 잡았네! 써니호, 쿠 드 버스트로 에그헤드 포위망을 돌파하네!"
        },
        {
          "speakerId": "luffy",
          "speakerName": "몽키 D. 루피",
          "emotion": "excited",
          "side": "left",
          "text": "최종장의 다음 무대다!! 전사의 나라 엘바프로 전속 전진이다아아!!",
          "directives": [{ "type": "sfx", "sfxId": "coup_de_burst" }]
        }
      ]
    }
  ]
}
